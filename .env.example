# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run in LOCAL DEMO MODE (menu stored in data/local-db.json).

# ---- Public site address (used for QR codes, emails, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Used for the exchange-rate job, owner setup and team invites.
SUPABASE_SECRET_KEY=

# ---- Automatic translation (one of these)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
DEEPL_API_KEY=

# ---- Exchange rates. Optional: without it the free open.er-api.com feed is used.
OPEN_EXCHANGE_RATES_APP_ID=

# ---- Protects /api/cron/rates (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# ---- Local demo mode only (ignored once Supabase is configured)
LOCAL_ADMIN_EMAIL=owner@demo.local
LOCAL_ADMIN_PASSWORD=fratellis-demo
LOCAL_AUTH_SECRET=change-this-to-a-long-random-string
